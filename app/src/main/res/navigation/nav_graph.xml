<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/FirstFragment">

    <fragment
        android:id="@+id/FirstFragment"
        android:name="com.example.projeto.FirstFragment"
        android:label="@string/first_fragment_label"
        tools:layout="@layout/fragment_first">

        <action
            android:id="@+id/action_FirstFragment_to_SecondFragment"
            app:destination="@id/SecondFragment" />

        <action
            android:id="@+id/action_FirstFragment_to_ThirdFragment"
            app:destination="@id/ThirdFragment" />

    </fragment>


    <fragment
        android:id="@+id/SecondFragment"
        android:name="com.example.projeto.SecondFragment"
        android:label="@string/second_fragment_label"
        tools:layout="@layout/fragment_second">

        <action
            android:id="@+id/action_SecondFragment_to_FirstFragment"
            app:destination="@id/FirstFragment" />

        <action
            android:id="@+id/action_SecondFragment_to_ThirdFragment"
            app:destination="@id/ThirdFragment" />

    </fragment>

    <fragment
        android:id="@+id/ThirdFragment"
        android:name="com.example.projeto.ThirdFragment"
        android:label="Third Fragment"
        tools:layout="@layout/fragment_third">

        <action
            android:id="@+id/action_ThirdFragment_to_FirstFragment"
            app:destination="@id/FirstFragment" />
        <action
            android:id="@+id/action_ThirdFragment_to_FourFragment"
            app:destination="@id/FourFragment"/>
    </fragment>

    <fragment
        android:id="@+id/FourFragment"
        android:name="com.example.projeto.FourFragment"
        android:label="Four Fragment"
        tools:layout="@layout/fragment_four">

        <action
            android:id="@+id/action_FourFragment_to_ThirdFragment"
            app:destination="@id/ThirdFragment" />

        <action
            android:id="@+id/action_FourFragment_to_FiveFragment"
            app:destination="@id/FiveFragment" />

    </fragment>
    <fragment
        android:id="@+id/FiveFragment"
        android:name="com.example.projeto.FiveFragment"
        android:label="Five Fragment"
        tools:layout="@layout/fragment_five">

        <action
        android:id="@+id/action_FiveFragment_to_FourFragment"
        app:destination="@id/FourFragment"/>

        <action
        android:id="@+id/action_FiveFragment_to_FirstFragment"
        app:destination="@id/FirstFragment"/>
    </fragment>

</navigation>