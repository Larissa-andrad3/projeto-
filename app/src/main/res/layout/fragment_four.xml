<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/azul"
    tools:context=".FirstFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="30dp"
        >
        <TextView
            android:id="@+id/textocentral"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clinicas em Manaus"
            android:textSize="35sp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/shapewhite"/>


        <LinearLayout
            android:id="@+id/linear1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginTop="-5dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textocentral"
            >
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/img1"
                android:layout_width="120dp"
                android:layout_height="90dp"
                android:src="@drawable/img_6"
                android:scaleType="centerCrop"
                android:background="@drawable/shaped"
                android:layout_gravity="center"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/RoundedImageView"/>
            <LinearLayout
                android:id="@+id/linear2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/texto2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:text="A Eye Center é uma clínica especializada em saúde ocular, oferecendo atendimento completo com tecnologia avançada. Conta com equipe médica qualificada para diagnóstico e tratamento de diversas condições visuais."
                    android:layout_marginStart="10dp"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginTop="5dp"
                    />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linear2c"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginTop="-30dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/linear1"
            >
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/img2"
                android:layout_width="120dp"
                android:layout_height="90dp"
                android:src="@drawable/img_7"
                android:scaleType="centerCrop"
                android:background="@drawable/shaped"
                android:layout_gravity="center"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/RoundedImageView"/>
            <LinearLayout
                android:id="@+id/linear3c"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/texto2c"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="O Julia Herrera Hospital de Olhos, com mais de 30 anos de atuação, é referência em oftalmologia de média e alta complexidade no Amazonas e região Norte, acreditado pela ONA com alto padrão de qualidade"
                    android:textColor="@color/black"
                    android:layout_marginStart="10dp"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginTop="5dp"
                    />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linear3cl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginTop="-30dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/linear2c"
            >
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/img3"
                android:layout_width="120dp"
                android:layout_height="90dp"
                android:src="@drawable/img_8"
                android:scaleType="centerCrop"
                android:background="@drawable/shaped"
                android:layout_gravity="center"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/RoundedImageView"/>

                <TextView
                    android:id="@+id/texto3c"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:text="A Amazon Oftalmologia,em Manaus/AM, oferece consultas oftalmológicas com equipe especializada e estrutura moderna para exames visuais e tratamentos básicos"
                    android:layout_marginStart="10dp"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginTop="5dp"
                    />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/linear4cl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginTop="-30dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/linear3cl"
            >
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/img4"
                android:layout_width="120dp"
                android:layout_height="90dp"
                android:src="@drawable/img_9"
                android:scaleType="centerCrop"
                android:background="@drawable/shaped"
                android:layout_gravity="center"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/RoundedImageView"/>

            <TextView
                android:id="@+id/texto4c"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:text="A AC Olhos Oftalmologia oferece consultas e exames especializados com atendimento humanizado e preços acessíveis em Manaus."
                android:layout_marginStart="10dp"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginTop="5dp"
                />

        </LinearLayout>






        <LinearLayout
            android:id="@+id/linearbutton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="20dp"
            android:layout_marginTop="-53dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/linear4cl"
            >
            <Button
                android:id="@+id/anteriorC"
                android:layout_width="130dp"
                android:layout_height="50dp"
                app:layout_constraintTop_toBottomOf="@id/linear5foto"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:backgroundTint="@color/black"
                android:layout_marginTop="5dp"
                android:text="Anterior"/>

            <LinearLayout
                android:id="@+id/linearbutton2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/seguinteC"
                    android:layout_width="130dp"
                    android:layout_height="50dp"
                    app:layout_constraintTop_toBottomOf="@id/linear5foto"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:backgroundTint="@color/black"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="20dp"
                    android:text="Seguinte"/>



            </LinearLayout>
        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>